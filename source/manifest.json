{
    "manifest_version": 3,
    "name": "MyChromeExtension",
    "version": "1.0.0",
    "minimum_chrome_version": "111",
    "description": "https://github.com/MoonLord-LM/MyChromeExtension",
    "author": "MoonLord-LM",
    "homepage_url": "https://github.com/MoonLord-LM/MyChromeExtension",
    "icons": {
        "16": "assets/icon16.png",
        "19": "assets/icon19.png",
        "32": "assets/icon32.png",
        "38": "assets/icon38.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png",
        "256": "assets/icon256.png",
        "512": "assets/icon512.png"
    },
    "permissions": [
        "storage"
    ],
    "action": {
        "default_icon": {
            "16": "assets/icon16.png",
            "19": "assets/icon19.png",
            "32": "assets/icon32.png",
            "38": "assets/icon38.png",
            "48": "assets/icon48.png",
            "128": "assets/icon128.png",
            "256": "assets/icon256.png",
            "512": "assets/icon512.png"
        },
        "default_title": "MyChromeExtension",
        "default_popup": "page/popup.html"
    },
    "options_page": "page/options.html",
    "devtools_page": "page/devtools.html",
    "host_permissions": [
        "<all_urls>"
    ],

    "content_scripts": [
        {
            "matches": [ "<all_urls>" ],
            "js": [ "site/all-main-world.js" ],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [ "<all_urls>" ],
            "js": [ "site/all.js" ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [ "http://v2ex.com/*", "https://v2ex.com/*", "http://*.v2ex.com/*", "https://*.v2ex.com/*" ],
            "js": ["site/www.v2ex.com.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [ "http://space.bilibili.com/*", "https://space.bilibili.com/*" ],
            "js": [ "site/space.bilibili.com.js" ],
            "run_at": "document_end"
        }
    ]
}
